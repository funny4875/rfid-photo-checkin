<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RFID Attendance Query" Manufacturer="CCSH" Version="$(var.Version)" UpgradeCode="5CF3A146-AB94-4F64-9386-16D09D78C20A" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="RFID Attendance Query">
        <Component Id="Application" Guid="*">
          <File Id="QueryExe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="QueryShortcut" Name="出勤紀錄查詢" Target="[INSTALLFOLDER]AttendanceQuery.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\CCSH\AttendanceQuery" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="Attendance Query">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
